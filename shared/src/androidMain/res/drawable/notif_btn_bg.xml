<?xml version="1.0" encoding="utf-8"?>
<!--
  Подложка кнопок «−»/«+» в строке вида.

  Ключевое здесь — `inset`, и он не косметика. Сама кнопка (`ImageButton`) остаётся 48×44, потому
  что это её область НАЖАТИЯ: высота строки 44dp взята как компромисс между рекомендацией Material
  в 48dp и лимитом Android в 256dp на всё содержимое уведомления, и недобор высоты компенсирован
  шириной — ужимать View значило бы ужимать попадание пальцем. Ужимается только то, что видно.

  Без отступа заливка занимала всю высоту строки, и у соседних строк пилюли стыкались вплотную:
  четыре вида подряд давали сплошной зелёный столбец вместо четырёх кнопок (репорт владельца
  2026-09-24). Отступ 5dp по вертикали разводит соседние строки на 10dp.

  Числа выведены из значка, а не подобраны: `padding="10dp"` у кнопки оставляет значку 24×24 по
  центру, то есть до краёв прежней пилюли было 12dp по горизонтали и 10dp по вертикали. Здесь
  ровно вдвое меньше — 6dp и 5dp, — как и просил владелец; итоговая пилюля 36×34.

  Радиус — половина высоты пилюли (34/2 = 17dp), чтобы она осталась пилюлей, а не прямоугольником
  со скруглением.

  `ripple` снаружи, а не вокруг самой формы: отклик на нажатие берёт границы ВСЕЙ кнопки, то есть
  всей области попадания, а видимая заливка сидит внутри отступа.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
        android:color="#40FFFFFF">
    <item>
        <inset android:insetLeft="6dp"
               android:insetRight="6dp"
               android:insetTop="5dp"
               android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/notif_action_bg"/>
                <corners android:radius="17dp"/>
            </shape>
        </inset>
    </item>
</ripple>
