<?xml version="1.0" encoding="utf-8"?>
<!--
  Радиусы пилюль на кнопках уведомления идущей записи.

  Вынесены из drawable в dimen ради одного: у российской редакции кнопки квадратные, и без этого
  пришлось бы дублировать все три drawable целиком (`androidApp/src/russia/res/values/dimens.xml`
  перекрывает эти значения — ресурсы модуля приложения главнее ресурсов библиотеки).

  Значения — половина высоты соответствующей пилюли, чтобы она оставалась пилюлей: 34/2 у кнопок
  в строке вида, 26/2 у кнопки паузы в заголовке. Разбор самих размеров — в KDoc drawable.
-->
<resources>
    <dimen name="notif_action_radius">17dp</dimen>
    <dimen name="notif_action_radius_header">13dp</dimen>
</resources>
