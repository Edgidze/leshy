<?xml version="1.0" encoding="utf-8"?>
<!--
  Цвета кнопок уведомления идущей записи («−», «+», пауза).

  Зачем свои, а не `@color/notification_action_color_filter` из androidx.core, который стоял здесь
  раньше: тот цвет — `#8a000000`, то есть тёмно-серый на 54% непрозрачности, и НОЧНОГО ВАРИАНТА у
  него нет вовсе (проверено 2026-09-24 по слитым ресурсам сборки: единственное определение лежит в
  `values/`). Он заведён платформой под значки действий СТАНДАРТНОГО шаблона уведомления, где
  система сама подставляет подложку; у нас шаблон свой, подложки нет, и от кнопки оставался бледный
  серый значок на голом фоне — владелец сообщил, что такие кнопки не читаются как нажимаемые.

  Отсюда конструкция: значок всегда БЕЛЫЙ и полностью непрозрачный, а видимость даёт заливка-пилюля
  под ним. Подстраховка на случай, если квалификатор `-night` в чужом процессе (SystemUI инфлейтит
  `RemoteViews` своими настройками) не сработает: белый значок читается на ОБЕИХ заливках, поэтому
  худшее, что может случиться, — тёмно-зелёная пилюля на тёмной шторке, то есть чуть хуже видимый
  контур при полностью читаемом значке. Обратная схема (тёмный значок на светлой пилюле) при том же
  сбое дала бы тёмное на тёмном, то есть невидимую кнопку, — поэтому её здесь нет.

  Ровно этой граблёй проект уже обжигался, но с другим механизмом: `?android:attr/textColorPrimary`
  не следует за темой шторки, потому что разрешается против темы ПРИЛОЖЕНИЯ, а она не DayNight (см.
  `androidMain/CLAUDE.md`). Квалификатор ресурса — механизм другой, он идёт от конфигурации, а не от
  темы, и потому применим; но раз уверенности на чужом процессе нет, схема выбрана отказоустойчивой.
-->
<resources>
    <!-- `LeshyGreen` из `ui/theme/Theme.kt` — та же фирменная зелень, что у кнопок в приложении. -->
    <color name="notif_action_bg">#FF1B4332</color>
    <!-- Заглушённая та же зелень: «−» на нуле находок. Кнопка есть, но сообщает, что жать нечего. -->
    <color name="notif_action_bg_disabled">#331B4332</color>
    <color name="notif_action_fg">#FFFFFFFF</color>
</resources>
