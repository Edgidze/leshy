<?xml version="1.0" encoding="utf-8"?>
<!--
  Одна строка развёрнутого уведомления: миниатюра вида, его название, «−», счётчик, «+». Кнопки
  шлют broadcast (WalkRecordingActionReceiver), а не запускают Activity, — именно поэтому они
  срабатывают прямо с заблокированного экрана: разблокировки система требует только для
  PendingIntent'ов на Activity.

  Счётчик стоит МЕЖДУ кнопками, а не перед ними: «−  N  +» читается как одна группа управления
  этим числом, и палец не промахивается мимо кнопки в цифру.

  Название — единственное, что тянется (`layout_weight`), поэтому длинное имя обрезается
  многоточием (`ellipsize="end"`, `maxLines="1"`), а миниатюра слева и группа кнопок справа
  никогда не съезжают и не сжимаются.

  44dp на строку — компромисс между рекомендацией Material в 48dp и лимитом Android в 256dp на всё
  содержимое (см. MAX_RECORDING_NOTIFICATION_SPECIES); недобор высоты кнопки компенсирован её
  шириной в 48dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="44dp"
              android:baselineAligned="false"
              android:gravity="center_vertical"
              android:orientation="horizontal">

    <ImageView
            android:id="@+id/species_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"/>

    <TextView
            android:id="@+id/species_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>

    <ImageButton
            android:id="@+id/species_remove"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_remove"
            android:tint="@color/notification_action_color_filter"/>

    <TextView
            android:id="@+id/species_count"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>

    <ImageButton
            android:id="@+id/species_add"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_add"
            android:tint="@color/notification_action_color_filter"/>
</LinearLayout>
