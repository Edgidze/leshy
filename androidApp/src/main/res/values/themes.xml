<?xml version="1.0" encoding="utf-8"?>
<!-- Нативная тема Activity. Видна ровно до первого кадра Compose (сплэш-экрана в проекте нет) и
     определяет цвет окна в эту долю секунды. Пока приложение было всегда светлым, здесь стоял
     прямой `@android:style/Theme.Material.Light.NoActionBar` — с тёмной темой он давал белую
     вспышку при холодном старте на тёмном устройстве.

     Парная values-night/themes.xml переключает её по системному оформлению. Системным, а не
     выбором в «Настройках»: окно рисует система ДО того, как приложение успевает прочитать
     DataStore, спросить у неё нечего. Остаточный случай — «Тёмная» выбрана в приложении при
     светлой системе (и наоборот): вспышка не того цвета останется. Умолчание настройки —
     «Системная», так что случай редкий; лечится только настоящим splash-экраном. -->
<resources>
    <style name="Theme.Leshy" parent="@android:style/Theme.Material.Light.NoActionBar" />
</resources>
