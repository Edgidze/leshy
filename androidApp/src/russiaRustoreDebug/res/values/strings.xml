<?xml version="1.0" encoding="utf-8"?>
<!-- Парная строка к src/debug/res: debug-сборка ставится рядом с релизной (applicationIdSuffix
     ".dev"), и без своего имени в лаунчере оказались бы два одинаковых значка.

     Почему каталог назван ПОЛНЫМ именем варианта, а не «russiaDebug»: при двух измерениях
     флейворов source set «флейвор одного измерения + сборочный тип» не существует — AGP знает
     только main, каждый флейвор, комбинацию флейворов (`russiaRustore`), сборочный тип
     (`debug`) и вариант целиком. Отсюда же и дубль файла на два варианта.

     Вариант перебивает сборочный тип по приоритету, поэтому эта строка выигрывает у «Леший dev»
     из src/debug/res. Без неё российская debug-сборка называлась бы именем мирового продукта. -->
<resources>
    <string name="app_name">Прогулки dev</string>
</resources>
